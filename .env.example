# AgenteOS — Variáveis de ambiente (produção)
# Configuração de uma instância AgenteOS em produção.
# Substitua os valores de placeholder conforme necessário.

# ── Docker — Imagens ──────────────────────────────────────────────────────
# Prefixo do registry (com barra embutida). Ex.: docker.dataagile.com.br/agenteos/agenteos-
IMAGE_PREFIX=docker.dataagile.com.br/agenteos/agenteos-
# Tag das imagens (ex.: latest ou data imutável YYYY.MM.DD-<hash>)
IMAGE_TAG=latest

# ── Ambiente ──────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
DEBUG=false

# ── Porta do host (nginx) ─────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
# Dashboard do Hatchet (sempre loopback-only; sandbox usa 8889)
HATCHET_DASHBOARD_PORT=8888

# ── Database ──────────────────────────────────────────────────────────────
# Credenciais do PostgreSQL (defaults inaceitáveis em produção — obrigatório trocar)
POSTGRES_USER=agenteos
POSTGRES_PASSWORD=trocar-obrigatoriamente
POSTGRES_DB=agenteos
# DAI-932 — papel de runtime SEM superusuário (a RLS multi-tenant só vale assim).
# Recomendado em qualquer instalação nova: descomente as duas linhas e gere uma
# senha própria (openssl rand -hex 32). O db-migrate cria o papel e os grants
# sozinho no próximo `docker compose up`. Sem elas, os apps conectam com o
# usuário de bootstrap acima (superusuário — RLS ignorada).
#POSTGRES_RUNTIME_USER=agenteos_runtime
#POSTGRES_RUNTIME_PASSWORD=trocar-obrigatoriamente

# ── Segredos obrigatórios (fail-closed) ───────────────────────────────────
# Chave geral da aplicação. Gerar com: openssl rand -hex 32
SECRET_KEY=trocar-obrigatoriamente

# Chave mestra do LiteLLM (proxy de modelos). Obrigatória para que LLM funcione.
LITELLM_MASTER_KEY=trocar-obrigatoriamente

# Chave mestre de MFA (autenticação multi-fator). Gerar com: openssl rand -hex 32
APP_MFA_MASTER_KEY=trocar-obrigatoriamente

# Token interno do JWT (autenticação entre serviços). Gerar com: openssl rand -hex 32
JWT_INTERNAL_SECRET=trocar-obrigatoriamente

# Token de autenticação interna entre serviços. Gerar com: openssl rand -hex 32
INTERNAL_TOKEN=trocar-obrigatoriamente

# Token de autenticação hub → spoke (se spoke, preencher com valor real).
# Em produção, deve ser um valor forte e único. Gerar com: openssl rand -hex 32
SERVICE_TOKEN=trocar-obrigatoriamente

# Chave HMAC para encurtamento de URLs (canais). Gerar com: openssl rand -hex 32
SHORT_LINK_HMAC_SECRET=trocar-obrigatoriamente

# ── Hatchet (orquestração de workflows) ───────────────────────────────────
# Email do administrador inicial do dashboard Hatchet.
# Será criado automaticamente no boot; trocar a senha após o primeiro login.
HATCHET_ADMIN_EMAIL=admin@agenteos.local

# Senha do administrador inicial (será criada no boot; obrigatório trocar).
# POLÍTICA DE SENHA DO HATCHET: 8 a 64 caracteres, com pelo menos uma
# MAIÚSCULA, uma minúscula e um DÍGITO. Senha só-hex (`openssl rand -hex`) é
# RECUSADA e o admin não é criado; o sintoma aparece tarde e disfarçado, como
# `HTTP 400` em /api/v1/users/login no log do `hatchet-token-init` (o motivo
# real, `ADMIN_PASSWORD does not meet requirements`, fica no log do `hatchet`).
# Gerador que sempre atende:  printf 'Ag%s1\n' "$(openssl rand -hex 12)"
HATCHET_ADMIN_PASSWORD=Trocar-obrigatoriamente1

# Para acesso local (padrão): deixar vazio ou false
HATCHET_COOKIE_INSECURE=f
HATCHET_COOKIE_DOMAIN=hatchet.yourdomain.com
HATCHET_SERVER_URL=https://hatchet.yourdomain.com

# ── Hatchet — token dos workers (gerado APÓS o primeiro boot) ─────────────
# Deixe vazio no primeiro `up -d`. Os workers vão reiniciar em loop até o
# passo "Token do Hatchet" do README ser executado (gera e grava aqui).
HATCHET_CLIENT_TOKEN=
# ── Grafana (observabilidade) ─────────────────────────────────────────────
# Senha do usuário admin do Grafana (será criado no boot). Trocar obrigatoriamente.
GRAFANA_ADMIN_PASSWORD=trocar-obrigatoriamente

# ── LLM — Chaves de tenant (zero-hardcode) ────────────────────────────────
# Chave do pool TBC de LLM (key_ownership='tbc'). Se vazio, modelos 'tbc' falham cedo.
TBC_LLM_POOL_KEY=

# Chave de cifra para segredos de LLM de tenant (key_ownership='tenant', Fernet).
# Gerar com: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Se vazio, cadastro de "Chave própria" fica desabilitado (fail-closed).
LLM_SECRET_ENC_KEY=

# ── E-mail transacional (convites internos, recuperação de senha) ──────────
# Token do serviço Resend (https://resend.com) para o envio de e-mail DESTA
# instância — convites que o admin desta empresa cria pelo próprio painel
# (equipe interna) e recuperação de senha.
# O e-mail do PRIMEIRO convite (quando a TBC provisiona esta empresa) é
# enviado pelo HUB da TBC com o Resend dele — esta chave não é necessária
# para o onboarding inicial funcionar.
# Se vazio: nenhum e-mail é enviado por esta instância, o link de convite
# continua aparecendo no painel (entregue manualmente) e a tela de usuários
# mostra um aviso para configurar o Resend.
RESEND_API_KEY=

# Endereço de e-mail "De" para mensagens transacionais desta instância.
RESEND_FROM_EMAIL=noreply@yourdomain.com

# URL base do link de convite (usada nos e-mails desta instância e devolvida
# ao hub da TBC para montar o link do primeiro convite).
# Ex.: https://yourdomain.com
INVITE_LINK_BASE=https://yourdomain.com

# ── Observabilidade (Sentry) ──────────────────────────────────────────────
# DSN do Sentry (rastreamento de erros). Se vazio, Sentry é desabilitado.
SENTRY_DSN=

# ── Feedback do usuário → GLPI ────────────────────────────────────────────
# Vazio = botão "Enviar feedback" escondido. Credenciais no KeePass (Sistemas):
# "GLPI OAuth client agenteos (API v2)", "GLPI usuario agenteos-api",
# "GLPI API v1 app-token agenteos". V1_* só para anexo de imagem.
GLPI_URL=
GLPI_CLIENT_ID=
GLPI_CLIENT_SECRET=
GLPI_API_USER=
GLPI_API_PASSWORD=
GLPI_V1_APP_TOKEN=
GLPI_V1_USER_TOKEN=

# ── Rede: anti-SSRF do poll de build assíncrono ───────────────────────────
# Quando um agente dispara um build assíncrono, o ERP devolve uma `job_url`
# que o gateway consulta. Essa URL vem de fora, então passa por um guard.
#
# VAZIO (padrão, recomendado): o gateway resolve o hostname e RECUSA se o IP
# for interno (loopback/privado/link-local/reservado) — bloqueia leitura de
# metadados de cloud e serviços internos.
#
# PREENCHIDA (CSV de hostnames): casa apenas o hostname e PULA a checagem de
# IP interno para esses hosts. É o único jeito de permitir um alvo em rede
# interna (ex.: `build-service`), e por isso mesmo mantenha a lista curta e
# só com hosts que você controla.
CHAT_JOB_URL_ALLOWED_HOSTS=

# ── Outros ────────────────────────────────────────────────────────────────
# URL de Hatchet interna (usado pelo litellm se houver dashboard exposto).
LITELLM_REDIS_URL=redis://redis:6379/0

# Retenção de logs no Loki (ex.: 168h para 7 dias). Padrão: 168h.
LOKI_RETENTION_PERIOD=168h

# Teto de memória do Redis e política de despejo (DAI-1116). Pico medido em
# produção: ~3 MB, então 256mb dá folga larga. volatile-lru só despeja chave
# COM TTL — sessão sem TTL nunca cai em silêncio. Alerta em 70% (RedisMemoryHigh).
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=volatile-lru

# Profiles da stack — NÃO remova: runtime tem os workers (sem eles nenhum run executa).
# retrieval (embeddings/reranker) fica fora do kit v1.
# Para ativar WhatsApp (Evolution API), adicione ",channels" e configure EVOLUTION_* (ver README).
COMPOSE_PROFILES=runtime,hitl,evaluator

# 138 — consentimento OAuth no navegador (conector Google).
# OAUTH_STATE_SECRET: Tier-1, secret DEDICADO (nunca reaproveitar o
# JWT_INTERNAL_SECRET — este `state` atravessa o browser do usuário e a
# Google). Gere com: openssl rand -hex 32
OAUTH_STATE_SECRET=trocar-obrigatoriamente
# Base pública DESTE gateway; o redirect_uri vira {base}/api/v1/oauth/callback
# e precisa estar registrado na allowlist do cliente OAuth no Google.
# Vazio = autorização no navegador desligada (fail-closed).
OAUTH_CALLBACK_BASE_URL=
