# AgenteOS — Variáveis de ambiente (produção)
# Configuração de uma instância AgenteOS em produção.
# Substitua os valores de placeholder conforme necessário.

# ── Docker — Imagens ──────────────────────────────────────────────────────
# Prefixo do registry (com barra embutida). Ex.: dataagileai/agenteos-
IMAGE_PREFIX=dataagileai/agenteos-
# Tag das imagens (ex.: latest ou data imutável YYYY.MM.DD-<hash>)
IMAGE_TAG=latest

# ── Ambiente ──────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
DEBUG=false

# ── Porta do host (nginx) ─────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
# Dashboard do Hatchet (sempre loopback-only; sandbox usa 8889)
HATCHET_DASHBOARD_PORT=8888

# ── Database ──────────────────────────────────────────────────────────────
# Credenciais do PostgreSQL (defaults inaceitáveis em produção — obrigatório trocar)
POSTGRES_USER=agenteos
POSTGRES_PASSWORD=trocar-obrigatoriamente
POSTGRES_DB=agenteos

# ── Segredos obrigatórios (fail-closed) ───────────────────────────────────
# Chave geral da aplicação. Gerar com: openssl rand -hex 32
SECRET_KEY=trocar-obrigatoriamente

# Chave mestra do LiteLLM (proxy de modelos). Obrigatória para que LLM funcione.
LITELLM_MASTER_KEY=trocar-obrigatoriamente

# Chave mestre de MFA (autenticação multi-fator). Gerar com: openssl rand -hex 32
APP_MFA_MASTER_KEY=trocar-obrigatoriamente

# Token interno do JWT (autenticação entre serviços). Gerar com: openssl rand -hex 32
JWT_INTERNAL_SECRET=trocar-obrigatoriamente

# Token de autenticação interna entre serviços. Gerar com: openssl rand -hex 32
INTERNAL_TOKEN=trocar-obrigatoriamente

# Token de autenticação hub → spoke (se spoke, preencher com valor real).
# Em produção, deve ser um valor forte e único. Gerar com: openssl rand -hex 32
SERVICE_TOKEN=trocar-obrigatoriamente

# Chave HMAC para encurtamento de URLs (canais). Gerar com: openssl rand -hex 32
SHORT_LINK_HMAC_SECRET=trocar-obrigatoriamente

# ── Hatchet (orquestração de workflows) ───────────────────────────────────
# Email do administrador inicial do dashboard Hatchet.
# Será criado automaticamente no boot; trocar a senha após o primeiro login.
HATCHET_ADMIN_EMAIL=admin@agenteos.local

# Senha do administrador inicial (será criada no boot; obrigatório trocar).
HATCHET_ADMIN_PASSWORD=trocar-obrigatoriamente

# Para acesso local (padrão): deixar vazio ou false
HATCHET_COOKIE_INSECURE=f
HATCHET_COOKIE_DOMAIN=hatchet.yourdomain.com
HATCHET_SERVER_URL=https://hatchet.yourdomain.com

# ── Hatchet — token dos workers (gerado APÓS o primeiro boot) ─────────────
# Deixe vazio no primeiro `up -d`. Os workers vão reiniciar em loop até o
# passo "Token do Hatchet" do README ser executado (gera e grava aqui).
HATCHET_CLIENT_TOKEN=
# ── Grafana (observabilidade) ─────────────────────────────────────────────
# Senha do usuário admin do Grafana (será criado no boot). Trocar obrigatoriamente.
GRAFANA_ADMIN_PASSWORD=trocar-obrigatoriamente

# ── LLM — Chaves de tenant (zero-hardcode) ────────────────────────────────
# Chave do pool TBC de LLM (key_ownership='tbc'). Se vazio, modelos 'tbc' falham cedo.
TBC_LLM_POOL_KEY=

# Chave de cifra para segredos de LLM de tenant (key_ownership='tenant', Fernet).
# Gerar com: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Se vazio, cadastro de "Chave própria" fica desabilitado (fail-closed).
LLM_SECRET_ENC_KEY=

# ── E-mail transacional (convites, recuperação de senha) ────────────────────
# Token do serviço Resend (https://resend.com) para envio de e-mail.
# Se vazio, convites e recuperação de senha ficam desabilitados.
RESEND_API_KEY=

# Endereço de e-mail "De" para mensagens transacionais.
RESEND_FROM_EMAIL=noreply@yourdomain.com

# URL base do link de convite (será utilizada em e-mails de convidado).
# Ex.: https://yourdomain.com
INVITE_LINK_BASE=https://yourdomain.com

# ── Observabilidade (Sentry) ──────────────────────────────────────────────
# DSN do Sentry (rastreamento de erros). Se vazio, Sentry é desabilitado.
SENTRY_DSN=

# ── Outros ────────────────────────────────────────────────────────────────
# URL de Hatchet interna (usado pelo litellm se houver dashboard exposto).
LITELLM_REDIS_URL=redis://redis:6379/0

# Retenção de logs no Loki (ex.: 168h para 7 dias). Padrão: 168h.
LOKI_RETENTION_PERIOD=168h

# Profiles da stack — NÃO remova: runtime tem os workers (sem eles nenhum run executa).
# retrieval (embeddings/reranker) fica fora do kit v1.
# Para ativar WhatsApp (Evolution API), adicione ",channels" e configure EVOLUTION_* (ver README).
COMPOSE_PROFILES=runtime,hitl,evaluator
