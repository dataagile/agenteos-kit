{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "AgenteOS — Postgres: conexões ativas, queries lentas >200ms, tamanho de tabelas. Fonte: postgres_exporter.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Conexões",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "pg_stat_activity_count{state!=\"idle\"}",
          "legendFormat": "Ativas (não-idle)",
          "refId": "A"
        },
        {
          "expr": "pg_stat_activity_count",
          "legendFormat": "Total",
          "refId": "B"
        },
        {
          "expr": "pg_settings_max_connections",
          "legendFormat": "Max connections",
          "refId": "C"
        }
      ],
      "title": "Conexões Ativas vs Max",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "percent", "min": 0, "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "(\n  pg_stat_activity_count{state!=\"idle\"}\n  / pg_settings_max_connections\n) * 100",
          "legendFormat": "Saturação %",
          "refId": "A"
        }
      ],
      "title": "Saturação de Conexões (%)",
      "type": "gauge"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "title": "Queries Lentas (>200ms — log_min_duration_statement)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(pg_stat_statements_total_time_seconds_total[5m])",
          "legendFormat": "Total query time rate",
          "refId": "A"
        }
      ],
      "title": "pg_stat_statements — Taxa de Tempo Total (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "pg_stat_statements_mean_time_seconds",
          "legendFormat": "{{ queryid }} — mean",
          "refId": "A"
        }
      ],
      "title": "Latência Média por Query (pg_stat_statements)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 7,
      "title": "Tamanho de Tabelas",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "bytes" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 19 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "pg_stat_user_tables_n_live_tup",
          "legendFormat": "{{ relname }} — live rows",
          "refId": "A"
        }
      ],
      "title": "Linhas Vivas por Tabela (pg_stat_user_tables)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "bytes" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 27 },
      "id": 9,
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "expr": "pg_total_relation_size_bytes",
          "legendFormat": "{{ relname }}",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Tamanho Total por Tabela (bytes)",
      "type": "table",
      "transformations": [
        { "id": "sortBy", "options": { "fields": [{ "displayName": "Value", "desc": true }] } }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["agenteos", "postgres"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "AgenteOS — Postgres",
  "uid": "agenteos-postgres",
  "version": 1
}
