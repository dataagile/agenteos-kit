{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "AgenteOS — Logs Explorer: busca por tenant_id, run_id, request_id, level=ERROR. Fonte: Loki.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "loki", "uid": "agenteos-loki" },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{service=~\"$service\"} | json | request_id=~\"$request_id\" | tenant_id=~\"$tenant_id\" | run_id=~\"$run_id\" | level=~\"$level\"",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Log Volume",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "agenteos-loki" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 4 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({service=~\"$service\"} | json | level=~\"$level\" [$__interval]))",
          "legendFormat": "{{ level }}",
          "refId": "A"
        }
      ],
      "title": "Volume de Logs por Nível",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "agenteos-loki" },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 10 },
      "id": 3,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": true,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "expr": "{service=~\"$service\"} | json | request_id=~\"$request_id\" | tenant_id=~\"$tenant_id\" | run_id=~\"$run_id\" | level=~\"$level\"",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Logs — filtro: serviço / request_id / tenant_id / run_id / level",
      "type": "logs"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["agenteos", "logs"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": ".*", "value": ".*" },
        "hide": 0,
        "label": "Serviço",
        "name": "service",
        "options": [
          { "selected": true, "text": "Todos", "value": ".*" },
          { "selected": false, "text": "api-gateway", "value": "api-gateway" },
          { "selected": false, "text": "agent-runtime", "value": "agent-runtime" },
          { "selected": false, "text": "data-plane", "value": "data-plane" },
          { "selected": false, "text": "retrieval", "value": "retrieval" },
          { "selected": false, "text": "channels", "value": "channels" }
        ],
        "query": ".*\napi-gateway\nagent-runtime\ndata-plane\nretrieval\nchannels",
        "type": "custom"
      },
      {
        "current": { "selected": true, "text": ".*", "value": ".*" },
        "hide": 0,
        "label": "Level",
        "name": "level",
        "options": [
          { "selected": true, "text": "Todos", "value": ".*" },
          { "selected": false, "text": "ERROR", "value": "ERROR" },
          { "selected": false, "text": "WARNING", "value": "WARNING" },
          { "selected": false, "text": "INFO", "value": "INFO" },
          { "selected": false, "text": "DEBUG", "value": "DEBUG" }
        ],
        "query": ".*\nERROR\nWARNING\nINFO\nDEBUG",
        "type": "custom"
      },
      {
        "current": { "selected": true, "text": ".*", "value": ".*" },
        "hide": 0,
        "label": "request_id",
        "name": "request_id",
        "query": ".*",
        "type": "textbox"
      },
      {
        "current": { "selected": true, "text": ".*", "value": ".*" },
        "hide": 0,
        "label": "tenant_id",
        "name": "tenant_id",
        "query": ".*",
        "type": "textbox"
      },
      {
        "current": { "selected": true, "text": ".*", "value": ".*" },
        "hide": 0,
        "label": "run_id",
        "name": "run_id",
        "query": ".*",
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "AgenteOS — Logs Explorer",
  "uid": "agenteos-logs-explorer",
  "version": 1
}
