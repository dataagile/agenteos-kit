{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "AgenteOS E12 — Shadow Evals: concordance rate per agent, review coverage, ambiguous rate, drift over time. Metrics from evaluator OTel.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Concordância por Agente",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
      "description": "Taxa de concordância do agente com o operador (concordant / (concordant + divergent)). Meta: ≥ 95%.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.85 },
              { "color": "green", "value": 0.95 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
          "expr": "evaluator_concordance_rate",
          "legendFormat": "{{agent_spec_id}}",
          "refId": "A"
        }
      ],
      "title": "Concordância Atual por Agente (Gauge)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
      "description": "Evolução da taxa de concordância ao longo do tempo por agent_spec_id.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
          "expr": "evaluator_concordance_rate",
          "legendFormat": "{{agent_spec_id}}",
          "refId": "A"
        }
      ],
      "title": "Concordância ao Longo do Tempo",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 10,
      "title": "Cobertura de Revisão",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
      "description": "Casos pendentes de classificação por campanha. Alto valor indica backlog de triagem para o operador.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "id": 11,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
          "expr": "evaluator_cases_pending",
          "legendFormat": "campanha {{campaign_id}}",
          "refId": "A"
        }
      ],
      "title": "Casos Pendentes por Campanha",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
      "description": "Evolução de casos pendentes ao longo do tempo. Declínio esperado conforme operador triagem.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 10 },
      "id": 12,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
          "expr": "evaluator_cases_pending",
          "legendFormat": "{{campaign_id}}",
          "refId": "A"
        }
      ],
      "title": "Casos Pendentes ao Longo do Tempo",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 20,
      "title": "Taxa de Ambiguous e Escape",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
      "description": "Taxa de classificações ambíguas por campanha. Alerta: > 30% indica viés de operador ou critérios mal definidos.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.30 },
              { "color": "red", "value": 0.50 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "id": 21,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
          "expr": "shadow_campaign_ambiguous_rate",
          "legendFormat": "{{campaign_id}}",
          "refId": "A"
        }
      ],
      "title": "Taxa Ambiguous por Campanha (Gauge)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
      "description": "Evolução da taxa ambiguous ao longo do tempo. Threshold de alerta: 30% (linha de referência).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "orange", "value": 0.30 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 19 },
      "id": 22,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
          "expr": "shadow_campaign_ambiguous_rate",
          "legendFormat": "{{campaign_id}}",
          "refId": "A"
        }
      ],
      "title": "Taxa Ambiguous ao Longo do Tempo",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 30,
      "title": "Drift Semanal (Golden Set)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
      "description": "Drift de concordância em p.p. vs. golden set run anterior. Alerta quando drift_delta_pp < -3 p.p.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": -3 },
              { "color": "yellow", "value": -1 },
              { "color": "green", "value": 0 }
            ]
          },
          "unit": "none",
          "min": -20,
          "max": 5,
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
      "id": 31,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
          "expr": "evaluator_drift_pp",
          "legendFormat": "{{agent_spec_id}}",
          "refId": "A"
        }
      ],
      "title": "Drift Atual por Agente (p.p.)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
      "description": "Histórico de drift por agente. Linha de alerta em -3 p.p. (cron semanal G7-T5).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "none",
          "decimals": 1,
          "custom": {
            "thresholdsStyle": { "mode": "dashed+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": -3 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 28 },
      "id": 32,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "agenteos-prometheus" },
          "expr": "evaluator_drift_pp",
          "legendFormat": "{{agent_spec_id}}",
          "refId": "A"
        }
      ],
      "title": "Drift ao Longo do Tempo (p.p.)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["e12", "shadow", "evaluator", "concordance"],
  "templating": { "list": [] },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "E12 — Shadow Evals",
  "uid": "e12-shadow-evals",
  "version": 1
}
