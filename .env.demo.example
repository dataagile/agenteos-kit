# AgenteOS — Variáveis de ambiente (DEMO)
# Configuração da instância demo (roteiro guiado com dados fictícios — 114).
# Mesmo artefato de imagem da produção/sandbox; o que muda é só configuração.
# IMPORTANTE: gere segredos DIFERENTES dos de produção — as instâncias são isoladas.

# ── Docker — Imagens ──────────────────────────────────────────────────────
# Mesmas imagens da produção; a diferença entre as instâncias é só configuração.
IMAGE_PREFIX=docker.dataagile.com.br/agenteos/agenteos-
IMAGE_TAG=latest

# ── Ambiente ──────────────────────────────────────────────────────────────
APP_ENV=staging
LOG_LEVEL=INFO
DEBUG=false

# ── Modo demo (114) ─────────────────────────────────────────────────────────
# `demo` liga o roteiro fictício: `/public/config` expõe `app_mode: "demo"`
# (faixa na UI), o guard de conexão só aceita o conector `demo` (fail-closed —
# nenhum Protheus/Itaú real nesta instância) e a aba "Refazer demo" fica
# visível nas Configurações do agente. NÃO ligue em produção real.
APP_MODE=demo

# Slug do tenant demo — precisa já existir no HUB de produção (hub-first:
# tenant, empresa, contrato e usuários nascem no hub, nunca neste spoke). O
# seed do spoke (db-migrate) falha alto se o tenant não estiver propagado.
DEMO_TENANT_SLUG=demo-dataagile

# Raiz das fixtures fictícias (dataset "Aurora Indústria Ltda"). VAZIO = usa as
# fixtures empacotadas na imagem, que é o certo em qualquer deploy normal. Só
# preencha apontando para a pasta que contém as SUBPASTAS POR AGENTE
# (`.../demo_fixtures/fixtures`, não a raiz do pacote) — caminho errado faz o
# seed abortar com "sem fixtures para o agente 'fin-pagamentos'".
DEMO_FIXTURES_ROOT=

# ── Portas do host (não podem colidir com produção/sandbox) ───────────────
DEMO_HTTP_PORT=8091

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=agenteos
POSTGRES_PASSWORD=trocar-para-ambiente-demo
POSTGRES_DB=agenteos

# ── Segredos obrigatórios (fail-closed; gerar valores PRÓPRIOS da demo) ────
# Chave geral da aplicação. Gerar com: openssl rand -hex 32
SECRET_KEY=trocar-para-ambiente-demo

# Chave mestra do LiteLLM (proxy de modelos).
LITELLM_MASTER_KEY=trocar-para-ambiente-demo

# Chave mestre de MFA. Gerar com: openssl rand -hex 32
APP_MFA_MASTER_KEY=trocar-para-ambiente-demo

# Token interno do JWT. Gerar com: openssl rand -hex 32
JWT_INTERNAL_SECRET=trocar-para-ambiente-demo

# Token de autenticação interna entre serviços. Gerar com: openssl rand -hex 32
INTERNAL_TOKEN=trocar-para-ambiente-demo

# Token de autenticação hub → spoke. Gerar com: openssl rand -hex 32
SERVICE_TOKEN=trocar-para-ambiente-demo

# Chave HMAC para encurtamento de URLs (canais). Gerar com: openssl rand -hex 32
SHORT_LINK_HMAC_SECRET=trocar-para-ambiente-demo

# ── Hatchet (orquestração de workflows) ───────────────────────────────────
# Admin inicial do dashboard Hatchet, criado no boot. As duas são obrigatórias:
# o compose falha explícito sem elas.
HATCHET_ADMIN_EMAIL=admin@demo.local

# ATENÇÃO à política de senha do Hatchet: 8 a 64 caracteres com pelo menos uma
# MAIÚSCULA, uma minúscula e um DÍGITO. Uma senha só-hex (`openssl rand -hex`)
# é recusada e o Hatchet NÃO cria o admin — o erro aparece tarde e disfarçado,
# como `HTTP 400` em /api/v1/users/login vindo do `hatchet-token-init`, com o
# motivo real (`ADMIN_PASSWORD does not meet requirements`) só no log do
# container `hatchet`. Gerador que sempre atende à política:
#   printf 'Ag%s1\n' "$(openssl rand -hex 12)"
HATCHET_ADMIN_PASSWORD=Trocar-para-ambiente-demo1

# ── Grafana ───────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=trocar-para-ambiente-demo

# ── Links de convite (base pública desta instância) ───────────────────────
INVITE_LINK_BASE=http://localhost:8091

# ── Observabilidade (Sentry) ───────────────────────────────────────────────
SENTRY_DSN=

# ── Feedback do usuário → GLPI ────────────────────────────────────────────
# Vazio = botão "Enviar feedback" escondido. Credenciais no KeePass (Sistemas):
# "GLPI OAuth client agenteos (API v2)", "GLPI usuario agenteos-api",
# "GLPI API v1 app-token agenteos". V1_* só para anexo de imagem.
GLPI_URL=
GLPI_CLIENT_ID=
GLPI_CLIENT_SECRET=
GLPI_API_USER=
GLPI_API_PASSWORD=
GLPI_V1_APP_TOKEN=
GLPI_V1_USER_TOKEN=

# ── Outros ──────────────────────────────────────────────────────────────────
LITELLM_REDIS_URL=redis://redis:6379/0
LOKI_RETENTION_PERIOD=168h

# Teto de memória do Redis e política de despejo (DAI-1116). Pico medido em
# produção: ~3 MB, então 256mb dá folga larga. volatile-lru só despeja chave
# COM TTL — sessão sem TTL nunca cai em silêncio. Alerta em 70% (RedisMemoryHigh).
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=volatile-lru

# Profiles da stack — igual sandbox; a demo também precisa do WhatsApp
# dedicado (canal isolado, RN-03), configure EVOLUTION_* se disponível.
COMPOSE_PROFILES=runtime,hitl,evaluator

# 138 — consentimento OAuth no navegador (conector Google).
# OAUTH_STATE_SECRET: Tier-1, secret DEDICADO (nunca reaproveitar o
# JWT_INTERNAL_SECRET — este `state` atravessa o browser do usuário e a
# Google). Gere com: openssl rand -hex 32
OAUTH_STATE_SECRET=trocar-obrigatoriamente
# Base pública DESTE gateway; o redirect_uri vira {base}/api/v1/oauth/callback
# e precisa estar registrado na allowlist do cliente OAuth no Google.
# Vazio = autorização no navegador desligada (fail-closed).
OAUTH_CALLBACK_BASE_URL=
