# AgenteOS — Variáveis de ambiente (SANDBOX)
# Configuração da instância sandbox (autoria e validação de agentes via MCP).
# Roda lado a lado com a produção no mesmo servidor, como projeto compose separado.
# IMPORTANTE: gere segredos DIFERENTES dos de produção — as instâncias são isoladas.

# ── Docker — Imagens ──────────────────────────────────────────────────────
# Mesmas imagens da produção; a diferença entre as instâncias é só configuração.
IMAGE_PREFIX=docker.dataagile.com.br/agenteos/agenteos-
IMAGE_TAG=latest

# ── Ambiente ──────────────────────────────────────────────────────────────
APP_ENV=staging
LOG_LEVEL=INFO
DEBUG=false

# ── Portas do host (não podem colidir com a produção) ─────────────────────
# Painel web do sandbox (nginx)
SANDBOX_HTTP_PORT=8090
# MCP server — porta do host em LOOPBACK por default (o MCP fala HTTP puro;
# o acesso externo é sempre pela rota /mcp do nginx, com TLS):
#   https://<dominio-do-sandbox>/mcp
MCP_PORT=127.0.0.1:8100

# ── MCP — autoria de agentes (OBRIGATÓRIO para o MCP funcionar) ───────────
# O MCP nasce DESLIGADO. Sem estas variáveis o /mcp recusa tudo e a página
# Configurações → Chaves MCP responde erro (503).
# 1. Habilite:
MCP_ENABLED=true
# 2. Allowlist de tenants: o UUID do tenant deste ambiente. Ele é gerado no
#    provisionamento (hub → provision-tenant) — descubra com:
#    docker compose exec postgres psql -U agenteos -d agenteos -Atc "select id from tenants"
MCP_ALLOWED_TENANT_IDS=[]
# 3. Tenant admin da página de Chaves MCP (mesmo UUID acima):
MCP_ADMIN_TENANT_ID=
# 4. Chave admin (scope keys.admin) usada pela página de Chaves MCP — emita
#    DEPOIS de subir o mcp-server com os itens 1-3:
#    docker compose exec mcp-server sh -lc 'PYTHONPATH=/app/packages/mcp-server/src \
#      /app/.venv/bin/python -m mcp_server.admin issue-key --tenant <UUID> \
#      --scope keys.admin --ttl-days 365 --label "admin ui"'
MCP_ADMIN_KEY=
# Dashboard Hatchet do sandbox (loopback only; produção usa 8888)
SANDBOX_HATCHET_PORT=8889

# ── Rede: anti-SSRF do poll de build assíncrono ───────────────────────────
# Quando um agente dispara um build assíncrono, o ERP devolve uma `job_url`
# que o gateway consulta. Essa URL vem de fora, então passa por um guard.
#
# VAZIO (padrão, recomendado): o gateway resolve o hostname e RECUSA se o IP
# for interno (loopback/privado/link-local/reservado) — bloqueia leitura de
# metadados de cloud e serviços internos.
#
# PREENCHIDA (CSV de hostnames): casa apenas o hostname e PULA a checagem de
# IP interno para esses hosts. É o único jeito de permitir um alvo em rede
# interna (ex.: `build-service`), e por isso mesmo mantenha a lista curta e
# só com hosts que você controla.
CHAT_JOB_URL_ALLOWED_HOSTS=

# ── Console admin (só existe na variante sandbox) ─────────────────────────
ADMIN_SERVER_NAME=admin.localhost

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=agenteos
POSTGRES_PASSWORD=trocar-para-ambiente-sandbox
# DAI-932 — papel de runtime sem superusuário (vide .env.example); recomendado
# também no sandbox para a RLS valer igual à produção.
#POSTGRES_RUNTIME_USER=agenteos_runtime
#POSTGRES_RUNTIME_PASSWORD=trocar-para-ambiente-sandbox
POSTGRES_DB=agenteos

# ── Segredos obrigatórios (fail-closed; gerar valores PRÓPRIOS do sandbox) ─
# Chave geral da aplicação. Gerar com: openssl rand -hex 32
SECRET_KEY=trocar-para-ambiente-sandbox

# Chave mestra do LiteLLM (proxy de modelos).
LITELLM_MASTER_KEY=trocar-para-ambiente-sandbox

# Chave mestre de MFA. Gerar com: openssl rand -hex 32
APP_MFA_MASTER_KEY=trocar-para-ambiente-sandbox

# Token interno do JWT. Gerar com: openssl rand -hex 32
JWT_INTERNAL_SECRET=trocar-para-ambiente-sandbox

# Token de autenticação interna entre serviços. Gerar com: openssl rand -hex 32
INTERNAL_TOKEN=trocar-para-ambiente-sandbox

# Token de autenticação hub → spoke. Gerar com: openssl rand -hex 32
SERVICE_TOKEN=trocar-para-ambiente-sandbox

# Chave HMAC para encurtamento de URLs (canais). Gerar com: openssl rand -hex 32
SHORT_LINK_HMAC_SECRET=trocar-para-ambiente-sandbox

# ── Contratação self-service (101 / DAI-941) ──────────────────────────────
# `true` = quem pede um produto no marketplace recebe o contrato na hora, sem
# depender de alguém da TBC abrir no console do hub. É o que faz o autor
# conseguir rodar o agente que ele mesmo acabou de publicar pelo MCP.
#
# NASCE `false` MESMO NO EXEMPLO DE SANDBOX. Este arquivo é o kit PÚBLICO:
# `install.sh sandbox` copia o exemplo verbatim (só troca os `trocar-*`), então
# um `true` aqui ligaria self-service na sandbox de TODO cliente que instalar o
# kit — e aí qualquer operador daquele tenant contrata qualquer produto do
# catálogo local sem passar pela TBC. Ligar só no ambiente interno de autoria
# (sandbox-os), pelo env do Dokploy, nunca pelo arquivo distribuído.
#
# DEPENDE de MARKETPLACE_ENABLED=true (DAI-943): as rotas /api/v1/products/*
# ficam atrás de `require_marketplace`, então com o marketplace desligado esta
# flag não tem efeito nenhum — o pedido nem chega ao endpoint.
SELF_SERVICE_CONTRACTS=false

# ── Hatchet (orquestração de workflows) ───────────────────────────────────
# Admin inicial do dashboard Hatchet do sandbox (criado no boot).
HATCHET_ADMIN_EMAIL=admin@sandbox.local
# POLÍTICA DE SENHA DO HATCHET: 8 a 64 caracteres, com pelo menos uma
# MAIÚSCULA, uma minúscula e um DÍGITO. Senha só-hex (`openssl rand -hex`) é
# RECUSADA e o admin não é criado; o sintoma aparece tarde e disfarçado, como
# `HTTP 400` em /api/v1/users/login no log do `hatchet-token-init` (o motivo
# real, `ADMIN_PASSWORD does not meet requirements`, fica no log do `hatchet`).
# Gerador que sempre atende:  printf 'Ag%s1\n' "$(openssl rand -hex 12)"
HATCHET_ADMIN_PASSWORD=Trocar-para-ambiente-sandbox1

# Acesso local via túnel (padrão): defaults servem.
HATCHET_COOKIE_INSECURE=t
HATCHET_COOKIE_DOMAIN=
HATCHET_SERVER_URL=

# ── Hatchet — token dos workers (gerado APÓS o primeiro boot) ─────────────
# Deixe vazio no primeiro `up -d`. Os workers vão reiniciar em loop até o
# passo "Token do Hatchet" do README ser executado (gera e grava aqui).
HATCHET_CLIENT_TOKEN=
# ── Grafana (observabilidade) ─────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=trocar-para-ambiente-sandbox

# ── LLM — Chaves de tenant (zero-hardcode) ────────────────────────────────
# Chave do pool TBC de LLM. Se vazio, modelos 'tbc' falham cedo.
TBC_LLM_POOL_KEY=

# Chave de cifra (Fernet) dos segredos de LLM de tenant.
# Gerar com: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_SECRET_ENC_KEY=

# ── E-mail transacional (convites internos) ───────────────────────────────
# Convites que você mesmo cria neste sandbox (equipe interna) + recuperação
# de senha. O 1º convite (provisionamento pela TBC) vem do hub da TBC — não
# depende desta chave. Sandbox normalmente fica sem e-mail real; deixe vazio
# (desabilitado) — o link de convite continua aparecendo no painel e a tela
# de usuários mostra um aviso.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
INVITE_LINK_BASE=https://sandbox.yourdomain.com

# ── Observabilidade (Sentry) ──────────────────────────────────────────────
SENTRY_DSN=

# ── Feedback do usuário → GLPI ────────────────────────────────────────────
# Vazio = botão "Enviar feedback" escondido. Credenciais no KeePass (Sistemas):
# "GLPI OAuth client agenteos (API v2)", "GLPI usuario agenteos-api",
# "GLPI API v1 app-token agenteos". V1_* só para anexo de imagem.
GLPI_URL=
GLPI_CLIENT_ID=
GLPI_CLIENT_SECRET=
GLPI_API_USER=
GLPI_API_PASSWORD=
GLPI_V1_APP_TOKEN=
GLPI_V1_USER_TOKEN=

# ── Outros ────────────────────────────────────────────────────────────────
LITELLM_REDIS_URL=redis://redis:6379/0
LOKI_RETENTION_PERIOD=168h

# Teto de memória do Redis e política de despejo (DAI-1116). Pico medido em
# produção: ~3 MB, então 256mb dá folga larga. volatile-lru só despeja chave
# COM TTL — sessão sem TTL nunca cai em silêncio. Alerta em 70% (RedisMemoryHigh).
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=volatile-lru

# Profiles da stack — NÃO remova: runtime tem os workers (sem eles nenhum run executa).
# retrieval (embeddings/reranker) fica fora do kit v1.
# Para ativar WhatsApp (Evolution API), adicione ",channels" e configure EVOLUTION_* (ver README).
COMPOSE_PROFILES=runtime,hitl,evaluator

# 138 — consentimento OAuth no navegador (conector Google).
# OAUTH_STATE_SECRET: Tier-1, secret DEDICADO (nunca reaproveitar o
# JWT_INTERNAL_SECRET — este `state` atravessa o browser do usuário e a
# Google). Gere com: openssl rand -hex 32
OAUTH_STATE_SECRET=trocar-obrigatoriamente
# Base pública DESTE gateway; o redirect_uri vira {base}/api/v1/oauth/callback
# e precisa estar registrado na allowlist do cliente OAuth no Google.
# Vazio = autorização no navegador desligada (fail-closed).
OAUTH_CALLBACK_BASE_URL=
